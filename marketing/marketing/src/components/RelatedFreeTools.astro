---
// Renders a "More free tools" cross-link block. Each free-tool page passes its
// own slug as `current` so it is excluded from the list (no self-link).
const { current } = Astro.props as { current: string };

const tools = [
  { slug: 'no-show-calculator', title: 'Tattoo No-Show Cost Calculator', desc: 'See exactly how much missed appointments cost your studio.' },
  { slug: 'tattoo-price-calculator', title: 'Tattoo Price Calculator', desc: 'Estimate tattoo cost by size, style, and placement before you quote.' },
  { slug: 'free-waiver-generator', title: 'Free Tattoo Consent Form & Waiver Generator', desc: 'Generate a consent form and waiver right in your browser — no download.' },
  { slug: 'aftercare-email-generator', title: 'Tattoo Aftercare Email Template Generator', desc: 'Send timed aftercare emails without forgetting a single client.' },
  { slug: 'tattoo-meaning-finder', title: 'Tattoo Meaning Finder', desc: 'Look up tattoo symbolism and talk meaning through with clients.' },
  { slug: 'commission-calculator', title: 'Commission Calculator', desc: 'Split artist vs shop commission fairly on every piece.' },
];

const others = tools.filter((t) => t.slug !== current);
---

<section class="border-t border-ink-800/50 py-16">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <h2 class="text-center text-2xl font-bold text-white">More free tools for tattoo studios</h2>
    <p class="mt-3 text-center text-gray-400">Every tool runs free in your browser — no download, no signup.</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {others.map((t) => (
        <a
          href={`/free-tools/${t.slug}`}
          class="group flex items-center gap-4 rounded-xl border border-ink-800 bg-ink-900/30 p-4 transition-all hover:border-accent-500/30"
        >
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-accent-500/15 text-lg font-bold text-accent-300 transition-colors group-hover:bg-accent-500/25">&#9881;</div>
          <div>
            <p class="font-semibold text-white transition-colors group-hover:text-accent-300">{t.title}</p>
            <p class="mt-0.5 text-xs text-gray-500">{t.desc} &rarr;</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
