---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEOHead from '../../components/SEOHead.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import FAQSchema from '../../components/FAQSchema.astro';
import TattooMeaningFinder from '../../components/TattooMeaningFinder.astro';
---

<BaseLayout>
  <SEOHead slot="head" title="Tattoo Meaning Finder — Search Symbolism &amp; Design Meanings" description="Discover the meaning behind popular tattoo symbols, flowers, animals, and cultural designs. Free search tool. No signup required." />
  <FAQSchema questions={[
    { question: "What symbols are included?", answer: "70+ curated symbols across 15 categories: animals, flowers, mythological, geometric, religious, cultural, nature, objects, birds, zodiac, insects, sea life, time, and words. Use the search tool above or browse the full A–Z index." },
    { question: "Can I suggest a meaning to add?", answer: "Yes. Contact us with your suggestion and a source. We review submissions and add new meanings regularly, citing cultural and historical references." },
    { question: "Are meanings culturally accurate?", answer: "Traditional meanings cite cultural and historical sources. Where a symbol carries different meanings across cultures, we label each tradition separately rather than merging them." },
    { question: "Is the Tattoo Meaning Finder free?", answer: "Yes. The finder is completely free and requires no signup. It is part of InkFlow's free tattoo-artist tools." },
    { question: "How do I use the finder with clients?", answer: "Search a symbol during a consultation, show its meaning and cultural notes, then link out to the full meaning page. It helps clients choose designs with personal or cultural significance." },
    { question: "Do you cover modern and style-based meanings?", answer: "Yes — alongside traditional symbolism we cover style meanings such as watercolor, minimalist, geometric, and abstract tattoos." },
    { question: "Where can I see all meanings?", answer: "Browse the complete A–Z symbol index at /tattoo-meaning/ for every curated symbol with its full meaning, origin, and cultural notes." },
  ]} />
