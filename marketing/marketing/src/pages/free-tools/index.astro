---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEOHead from '../../components/SEOHead.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import FAQSchema from '../../components/FAQSchema.astro';
import PageSchema from '../../components/PageSchema.astro';

const ARTICLE = {
  headline: 'Free Tattoo Studio Tools — Calculators, Generators & Finders | InkFlow',
  description: 'Six free, browser-based tools for tattoo studios: no-show cost calculator, price calculator, consent form & waiver generator, aftercare email generator, meaning finder, and commission calculator. No download, no signup.',
  author: {
    name: 'Sarah Chen',
    bio: 'Founder & CEO of InkFlow. 12 years managing multi-artist tattoo studios; built InkFlow to solve the booking, waiver, and client-retention problems she saw running shops.',
  },
  datePublished: '2026-06-20',
  dateModified: '2026-07-30',
};

const tools = [
  { slug: 'no-show-calculator', title: 'Tattoo No-Show Cost Calculator', desc: 'See exactly how much missed appointments cost your studio each year — and how much you could save.' },
  { slug: 'tattoo-price-calculator', title: 'Tattoo Price Calculator', desc: 'Estimate tattoo cost by size, style, and placement before you quote a client.' },
  { slug: 'free-waiver-generator', title: 'Free Tattoo Consent Form & Waiver Generator', desc: 'Generate a consent form and waiver right in your browser — no PDF download, no signup.' },
  { slug: 'aftercare-email-generator', title: 'Tattoo Aftercare Email Template Generator', desc: 'Send timed aftercare emails (day 3/7/14) without forgetting a single client.' },
  { slug: 'tattoo-meaning-finder', title: 'Tattoo Meaning Finder', desc: 'Look up tattoo symbolism across cultures and talk meaning through with clients.' },
  { slug: 'commission-calculator', title: 'Commission Calculator', desc: 'Split artist vs shop commission fairly on every piece — 60/40, 70/30, or custom.' },
];

const workflow = [
  { slug: 'tattoo-meaning-finder', step: '1', title: 'Research the meaning', text: 'Use the Meaning Finder to explore symbolism with a client before you draw.' },
  { slug: 'tattoo-price-calculator', step: '2', title: 'Quote accurately', text: 'Plug size, style, and placement into the Price Calculator so the quote is fair and fast.' },
  { slug: 'free-waiver-generator', step: '3', title: 'Collect consent', text: 'Generate a consent form and waiver in-browser — no app, no paper to file.' },
  { slug: 'no-show-calculator', step: '4', title: 'Cut no-shows', text: 'See the annual cost of missed appointments, then justify deposits and reminders.' },
  { slug: 'aftercare-email-generator', step: '5', title: 'Aftercare automatically', text: 'Send timed aftercare emails so healing guidance never slips through.' },
  { slug: 'commission-calculator', step: '6', title: 'Split commissions', text: 'Calculate artist vs shop take-home per session, week, and month.' },
];
---

<BaseLayout pageTitle="Free Tattoo Studio Tools" lastUpdated="2026-07-30">
  <SEOHead slot="head" title="Free Tattoo Studio Tools — Calculators, Generators & Finders" description="Six free, browser-based tools for tattoo studios: no-show cost calculator, price calculator, consent form & waiver generator, aftercare email generator, meaning finder, and commission calculator. No download, no signup." />
  <PageSchema type="article" data={ARTICLE} />
  <FAQSchema questions={[
    { question: "Are these tattoo studio tools really free?", answer: "Yes. All six tools run free in your browser. No account, no download, and no signup required." },
    { question: "Do I need to create an account to use them?", answer: "No. Each tool works instantly — generate, calculate, or look up a result and copy it anywhere you already message clients." },
    { question: "Can I use these tools on mobile?", answer: "Yes. They are responsive and work on phone, tablet, and desktop, so you can use them at the chair or at the front desk." },
  ]} />
  <Navbar />

  <!-- Hero -->
  <section class="pt-24 pb-12 sm:pt-32">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <p class="mb-3 text-sm font-semibold text-accent-400">FREE TOOLS</p>
      <h1 class="text-4xl font-extrabold text-white sm:text-5xl">Free Tools for Tattoo Studios</h1>
      <p class="mt-4 text-lg text-gray-400">Six browser-based calculators, generators, and finders — built for the way shops actually run. No download, no signup.</p>
    </div>
  </section>

  <!-- Tool grid -->
  <section class="pb-12">
    <div class="mx-auto grid max-w-5xl gap-4 px-4 sm:grid-cols-2 sm:px-6 lg:grid-cols-3 lg:px-8">
      {tools.map((t) => (
        <a
          href={`/free-tools/${t.slug}`}
          class="group flex flex-col rounded-xl border border-ink-800 bg-ink-900/30 p-5 transition-all hover:border-accent-500/30"
        >
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg bg-accent-500/15 text-lg font-bold text-accent-300 transition-colors group-hover:bg-accent-500/25">&#9881;</div>
          <p class="font-semibold text-white transition-colors group-hover:text-accent-300">{t.title}</p>
          <p class="mt-1.5 flex-1 text-sm text-gray-400">{t.desc}</p>
          <p class="mt-3 text-xs font-medium text-accent-300">Open tool &rarr;</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Workflow -->
  <section class="border-t border-ink-800/50 bg-ink-900/20 py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-center text-2xl font-bold text-white">How a studio uses them together</h2>
      <p class="mt-3 text-center text-gray-400">Each tool stands alone — but they cover the whole client journey, from first idea to paid and healed.</p>
      <div class="mt-8 space-y-4">
        {workflow.map((w) => (
          <a
            href={`/free-tools/${w.slug}`}
            class="group flex items-center gap-4 rounded-xl border border-ink-800 bg-ink-900/30 p-4 transition-all hover:border-accent-500/30"
          >
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-accent-500/15 text-lg font-bold text-accent-300 transition-colors group-hover:bg-accent-500/25">{w.step}</div>
            <div>
              <p class="font-semibold text-white transition-colors group-hover:text-accent-300">{w.title}</p>
              <p class="mt-0.5 text-sm text-gray-400">{w.text}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA to platform -->
  <section class="border-t border-ink-800/50 py-16">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-white">Want these to run themselves?</h2>
      <p class="mt-3 text-gray-400">InkFlow turns each free tool into an automated step — deposits, reminders, aftercare, and commission tracking, all in one platform.</p>
      <div class="mt-8">
        <a href="https://app.ink-flows.com/register" class="inline-block rounded-lg bg-accent-500 px-8 py-3.5 text-base font-semibold text-ink-950 transition-all hover:bg-accent-400">Start Free Trial — No Credit Card</a>
      </div>
    </div>
  </section>

  <!-- E-E-A-T -->
  <section class="border-t border-ink-800/50 bg-ink-900/20 py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-xl font-bold text-white">About these tools</h2>
      <p class="mt-3 text-sm leading-relaxed text-gray-400">
        Built by <strong class="text-white">Sarah Chen</strong> (Founder &amp; CEO, InkFlow) — 12 years managing multi-artist tattoo studios. Every tool reflects operational reality seen running shops: how no-shows actually hit chair time, why consent forms need to cover minors and e-signatures, and how commissions split on a real session.
      </p>
      <p class="mt-2 text-xs text-gray-600">Published {ARTICLE.datePublished} · Updated {ARTICLE.dateModified}</p>
    </div>
  </section>

  <Footer />
</BaseLayout>
