---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEOHead from '../../components/SEOHead.astro';
import { TATTOO_CATEGORIES } from '../../data/tattoo-meanings';

// Total index of the meaning section. Every pillar links UP to its category
// hub and to this index via breadcrumb + the "More {Category} Meanings" rail,
// so this page is the authority-consolidating hub for all 70+ symbol pages.
const cats = TATTOO_CATEGORIES.map((c) => ({
  name: c.name,
  desc: c.desc,
  seg: c.urlSegment ?? c.id,
  symbols: c.symbols.map((s) => ({
    name: s.name,
    slug: s.slug,
    meaning: s.meaning,
  })),
}));
---

<BaseLayout>
  <SEOHead
    slot="head"
    title="Tattoo Meanings & Symbolism — A-Z Symbol Guide"
    description="Explore the meaning and symbolism behind every tattoo: animals, flowers, mythological creatures, cultural icons, and more. 70+ symbols with cultural origins, history, and design ideas."
    canonical="https://ink-flows.com/tattoo-meaning/"
    appSchema={false}
  />
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
    <header class="mb-10">
      <h1 class="text-3xl font-bold text-white sm:text-4xl">Tattoo Meanings &amp; Symbolism</h1>
      <p class="mt-3 text-gray-400">
        A complete guide to what tattoos mean across cultures, traditions, and
        styles. Browse a category, or jump straight to a specific symbol.
      </p>
    </header>

    <div class="space-y-10">
      {cats.map((cat) => (
        <section>
          <h2 class="text-xl font-semibold text-white">
            <a href={`/tattoo-meaning/${cat.seg}/`} class="hover:text-accent-400">{cat.name} Tattoo Meanings</a>
          </h2>
          <p class="mt-1 text-sm text-gray-400">{cat.desc}</p>
          <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2">
            {cat.symbols.map((s) => (
              <li>
                <a
                  href={`/tattoo-meaning/${cat.seg}/${s.slug}-tattoo-meaning/`}
                  class="text-sm text-gray-300 hover:text-accent-400 hover:underline"
                >{s.name}</a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
