---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SEOHead from '../../../../components/SEOHead.astro';
import Navbar from '../../../../components/Navbar.astro';
import Footer from '../../../../components/Footer.astro';
import FAQSchema from '../../../../components/FAQSchema.astro';
import GallerySection from '../../../../components/GallerySection.astro';
import { ALL_MEANINGS, getMeaningBySlug, TATTOO_CATEGORIES } from '../../../../data/tattoo-meanings';
import { VARIANT_MEANINGS, getVariantsForSymbol } from '../../../../data/tattoo-meaning-variants';
import { EEAT_AUTHOR, EEAT_PUBLISHED, EEAT_UPDATED, CATEGORY_EEAT } from '../../../../data/tattoo-category-content';

// Public category segment: urlSegment override (sea-life -> "ocean") when present.
const catSeg = (catId: string): string => {
  const c = TATTOO_CATEGORIES.find((x) => x.id === catId);
  return c?.urlSegment ?? catId;
};

export async function getStaticPaths() {
  return VARIANT_MEANINGS.map((v) => {
    const parent = getMeaningBySlug(v.symbolSlug);
    const seg = parent
      ? (TATTOO_CATEGORIES.find((x) => x.id === parent.category)?.urlSegment ?? parent.category)
      : 'sea-life';
    return {
      params: {
        category: seg,
        symbol: `${v.symbolSlug}-tattoo-meaning`,
        variation: v.slug,
      },
      props: { variant: v },
    };
  });
}

const { variant } = Astro.props;
const parent = getMeaningBySlug(variant.symbolSlug);
const seg = parent ? catSeg(parent.category) : 'sea-life';
const category = parent ? TATTOO_CATEGORIES.find((c) => c.id === parent.category) : undefined;
const eeat = parent ? CATEGORY_EEAT[parent.category] ?? {} : {};
const reviewer = eeat.reviewer;

const lastUpdated = EEAT_UPDATED[variant.slug] ?? EEAT_PUBLISHED;
const siblings = getVariantsForSymbol(variant.symbolSlug).filter((v) => v.slug !== variant.slug);
const relatedSeaLife = parent
  ? ALL_MEANINGS.filter((m) => m.category === parent.category && m.slug !== parent.slug).slice(0, 3)
  : [];

const DEFAULT_RELATED_TOOLS = [
  { label: 'Tattoo Meaning Finder', href: '/free-tools/tattoo-meaning-finder' },
  { label: 'Tattoo Price Calculator', href: '/free-tools/tattoo-price-calculator' },
];
const relatedTools = variant.relatedTools ?? DEFAULT_RELATED_TOOLS;

const pageTitle = `${variant.name} Meaning & Symbolism — InkFlow`;
const pageDesc = `${variant.name} meaning: ${variant.meaning}. ${variant.desc}`;

const site = 'https://ink-flows.com';
const canonical = `${site}/tattoo-meaning/${seg}/${variant.symbolSlug}-tattoo-meaning/${variant.slug}`;
const parentHref = `${site}/tattoo-meaning/${seg}/${variant.symbolSlug}-tattoo-meaning`;

const articleJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pageTitle,
  description: pageDesc,
  url: canonical,
  author: {
    '@type': 'Person',
    name: EEAT_AUTHOR.name,
    jobTitle: EEAT_AUTHOR.title,
    url: EEAT_AUTHOR.url,
  },
  publisher: {
    '@type': 'Organization',
    name: 'InkFlow',
    url: site,
    logo: { '@type': 'ImageObject', url: `${site}/images/hero-screenshot-2.png` },
  },
  datePublished: EEAT_PUBLISHED,
  dateModified: lastUpdated,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  image: {
    '@type': 'ImageObject',
    url: `${site}/images/hero-screenshot-2.png`,
    caption: `${variant.name} meaning — visual guide`,
    width: 1200,
    height: 630,
  },
  about: { '@type': 'Thing', name: `${variant.name} meaning` },
});

// Breadcrumb trail fed to BaseLayout (Home > Tattoo Meanings > Category > Symbol > Variant).
// BaseLayout emits the single canonical BreadcrumbList JSON-LD + visible <nav> from this,
// so we drop the separate breadcrumb <script> to avoid a duplicate breadcrumb block.
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Tattoo Meanings', href: '/tattoo-meaning' },
  ...(category ? [{ label: category.name, href: `/tattoo-meaning/${seg}` }] : []),
  ...(parent ? [{ label: parent.name, href: parentHref }] : []),
  { label: variant.name },
];

const variantFaqs = variant.faqs ?? [];
---

<BaseLayout breadcrumbs={breadcrumbs} lastUpdated={lastUpdated} author="Sarah Chen">
  <SEOHead slot="head" title={pageTitle} description={pageDesc} appSchema={false} disableBreadcrumb />
  <Navbar />

  <script type="application/ld+json" set:html={articleJson} />
  {variantFaqs.length > 0 && <FAQSchema questions={variantFaqs} />}

  <!-- Hero -->
  <section class="pt-28 pb-12">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold text-accent-400 mb-2">
        <a href="/tattoo-meaning" class="hover:underline">TATTOO MEANINGS</a>
        {category ? <> / <a href={`/tattoo-meaning/${seg}`} class="hover:underline">{category.name.toUpperCase()}</a></> : ''}
        {parent ? <> / <a href={parentHref} class="hover:underline">{parent.name.toUpperCase()}</a></> : ''}
      </p>
      <div class="grid gap-8 md:grid-cols-2 md:items-start">
        <div>
          <h1 class="text-4xl font-extrabold text-white sm:text-5xl">{variant.name} Meaning</h1>
          <p class="mt-3 text-lg text-accent-400 leading-relaxed">{variant.meaning}</p>
          <p class="mt-4 text-gray-400 leading-relaxed">{variant.desc}</p>
        </div>
        <div class="flex justify-center md:justify-end">
          <div class="flex h-48 w-48 items-center justify-center rounded-2xl border border-ink-700 bg-ink-900/50 text-6xl text-accent-400/40 select-none">
            🦈
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cultural Notes -->
  {variant.culturalNotes && (
    <section class="border-t border-ink-800/50 py-12">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-white">Cultural &amp; Historical Significance</h2>
        <p class="mt-4 text-gray-400 leading-relaxed">{variant.culturalNotes}</p>
      </div>
    </section>
  )}

  <!-- Custom Sections -->
  {(variant.customSections ?? []).map((section) => (
    <section class="border-t border-ink-800/50 py-10">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-xl font-bold text-white">{section.heading}</h2>
        <p class="mt-3 text-gray-400 leading-relaxed">{section.text}</p>
      </div>
    </section>
  ))}

  <!-- Design Gallery -->
  <GallerySection
    symbolId={variant.slug}
    symbolName={variant.name}
    ctaLink={parentHref}
    ctaBtn={`Back to ${parent?.name ?? 'Meanings'}`}
    designSvgs={variant.designSvgs ?? []}
  />

  <!-- Sibling variants -->
  {siblings.length > 0 && (
    <section class="border-t border-ink-800/50 py-12 bg-ink-900/20">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-white">More {parent?.name ?? ''} Tattoo Variations</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {siblings.map((s) => (
            <a href={`/tattoo-meaning/${seg}/${s.symbolSlug}-tattoo-meaning/${s.slug}`} class="group flex items-center gap-4 rounded-xl border border-ink-800 bg-ink-900/30 p-4 hover:border-accent-500/30 transition-all">
              <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-ink-800/50 text-center text-2xl text-gray-400 group-hover:text-accent-400 transition-colors">🦈</div>
              <div>
                <p class="font-semibold text-white group-hover:text-accent-300 transition-colors">{s.name}</p>
                <p class="mt-0.5 text-xs text-gray-500">{s.meaning}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Related Sea Life -->
  {relatedSeaLife.length > 0 && (
    <section class="border-t border-ink-800/50 py-12">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-white">Related Sea Life Meanings</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
          {relatedSeaLife.map((r) => (
            <a href={`/tattoo-meaning/${catSeg(r.category)}/${r.slug}-tattoo-meaning`} class="group flex items-center gap-4 rounded-xl border border-ink-800 bg-ink-900/30 p-4 hover:border-accent-500/30 transition-all">
              <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-lg bg-ink-800/50 text-center text-2xl text-gray-400 group-hover:text-accent-400 transition-colors">{r.name[0]}</div>
              <div>
                <p class="font-semibold text-white group-hover:text-accent-300 transition-colors">{r.name}</p>
                <p class="mt-0.5 text-xs text-gray-500">{r.meaning}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Related Tools & Resources -->
  {relatedTools.length > 0 && (
    <section class="border-t border-ink-800/50 py-12 bg-ink-900/20">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-white">Related Tools &amp; Resources</h2>
        <p class="mt-2 text-sm text-gray-500">Find, price, and book the design you're exploring.</p>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {relatedTools.map((t) => (
            <a href={t.href} class="group flex items-center gap-4 rounded-xl border border-ink-800 bg-ink-900/30 p-4 hover:border-accent-500/30 transition-all">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-accent-500/15 text-accent-300 text-lg font-bold group-hover:bg-accent-500/25 transition-colors">&#9881;</div>
              <div>
                <p class="font-semibold text-white group-hover:text-accent-300 transition-colors">{t.label}</p>
                <p class="mt-0.5 text-xs text-gray-500">Open tool &rarr;</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  {variantFaqs.length > 0 && (
    <section class="border-t border-ink-800/50 py-12">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl font-bold text-white">Frequently Asked Questions</h2>
        <div class="mt-6 space-y-4">
          {variantFaqs.map((f) => (
            <details class="rounded-xl border border-ink-800 p-4">
              <summary class="cursor-pointer text-sm font-medium text-white">{f.question}</summary>
              <p class="mt-2 text-sm text-gray-400">{f.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="border-t border-ink-800/50 py-16 text-center">
    <h2 class="text-2xl font-bold text-white">Find Your Perfect Tattoo Design</h2>
    <p class="mt-3 text-gray-400 max-w-xl mx-auto">Get matched with the right meaning and style for your next tattoo.</p>
    <a href="https://app.ink-flows.com/register" class="mt-6 inline-block rounded-lg bg-accent-500 px-8 py-3.5 text-base font-semibold text-ink-950 hover:bg-accent-400 transition-all">Start Your Studio Free →</a>
  </section>

  <!-- Sources + EEAT -->
  <section class="border-t border-ink-800/50 py-8 bg-ink-900/20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      {variant.sources && variant.sources.length > 0 && (
        <div class="mb-3">
          <p class="text-xs font-semibold text-gray-500">Sources</p>
          <ul class="mt-1 space-y-1">
            {variant.sources.map((s) => (
              <li class="text-xs text-gray-600">
                <a href={s.url} target="_blank" rel="noopener noreferrer" class="text-accent-400 hover:underline">{s.label}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
      <p class="text-xs text-gray-600">EEAT: Written by {EEAT_AUTHOR.name} ({EEAT_AUTHOR.title}).{reviewer ? ` Verified against ${reviewer.name}.` : ''} Cultural and historical information is sourced from academic and specialist references and is provided for educational purposes. Meanings vary across traditions and interpretations.</p>
    </div>
  </section>

  <Footer />
</BaseLayout>
