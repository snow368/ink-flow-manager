---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEOHead from '../../components/SEOHead.astro';
import { TATTOO_CATEGORIES } from '../../data/tattoo-meanings';

// Category hub. Param must use the SAME segment logic as the pillar route
// (urlSegment override, e.g. sea-life -> "ocean"), otherwise we'd spawn a
// second, 404-ing URL set. The pillar already links UP to `/tattoo-meaning/${seg}/`,
// so creating this page closes the hub-and-spoke loop for every symbol.
export function getStaticPaths() {
  return TATTOO_CATEGORIES.map((cat) => ({
    params: { category: cat.urlSegment ?? cat.id },
    props: { cat },
  }));
}

const { cat } = Astro.props;
const seg = cat.urlSegment ?? cat.id;
---

<BaseLayout>
  <SEOHead
    slot="head"
    title={`${cat.name} Tattoo Meanings & Symbolism`}
    description={cat.desc}
    canonical={`https://ink-flows.com/tattoo-meaning/${seg}/`}
    appSchema={false}
  />
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
    <nav class="mb-6 text-sm">
      <a href="/tattoo-meaning/" class="text-gray-400 hover:text-accent-400">&larr; All tattoo meanings</a>
    </nav>
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-white sm:text-4xl">{cat.name} Tattoo Meanings</h1>
      <p class="mt-3 text-gray-400">{cat.desc}</p>
    </header>
    <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {cat.symbols.map((s) => (
        <li>
          <a
            href={`/tattoo-meaning/${seg}/${s.slug}-tattoo-meaning/`}
            class="block rounded-lg border border-ink-800 bg-ink-900/50 p-4 transition hover:border-accent-400"
          >
            <span class="font-medium text-white">{s.name} Tattoo Meaning</span>
            <span class="mt-1 block text-sm text-gray-400">{s.meaning}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
