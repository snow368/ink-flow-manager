        <li><a href="https://www.hhs.gov/hipaa/for-professionals/covered-entities/index.html" class="text-accent-400 hover:underline" target="_blank" rel="noopener">Covered Entities and Business Associates</a>, U.S. HHS (HIPAA scope)</li>
        <li><a href="https://www.fcc.gov/consumers/guides/stop-unwanted-robocalls-and-texts" class="text-accent-400 hover:underline" target="_blank" rel="noopener">Stop Unwanted Robocalls and Texts</a>, U.S. FCC (SMS consent)</li>
      </ul>
    </div>
  </section>

